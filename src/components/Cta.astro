---
import { MAIN } from '../lib';
import { categoryCta } from '../categories';
interface Props { vertical?: string; }
const c = categoryCta(Astro.props.vertical ?? '');
const title = c?.ctaTitle || 'See an AI agent work on your own leads';
const text = c?.ctaText || 'Book a 20-minute demo. We run it on your real enquiries, not a canned script.';
const button = c?.ctaButton || 'Book a demo';
const href = c?.ctaLink || `${MAIN}/contact/`;
---
<section class="cta">
  <h2>{title}</h2>
  <p>{text}</p>
  <div class="row"><a class="btn" href={href}>{button}</a></div>
</section>
