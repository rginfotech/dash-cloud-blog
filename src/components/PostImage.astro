---
import Cover from './Cover.astro';
import type { Post } from '../lib';
interface Props { post: Post; id?: string; eager?: boolean; }
const { post, id, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const { cover, coverAlt, vertical } = post.data;
---
{cover
  ? <img class="photo" src={`${base}${cover}`} alt={coverAlt} width="1600" height="1067" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  : <Cover vertical={vertical} id={id ?? post.id} />}
