---
import PostImage from './PostImage.astro';
import { VERTICALS } from '../content.config';
import { fmtDate, type Post } from '../lib';
const { post } = Astro.props as { post: Post };
const href = `${import.meta.env.BASE_URL}${post.id}/`;
---
<article class="card">
  <a class="cover-link" href={href} tabindex="-1" aria-hidden="true"><PostImage post={post} /></a>
  <div class="card-body">
    <h3><a href={href}>{post.data.title}</a></h3>
    <div class="meta"><span class="kind">{VERTICALS[post.data.vertical]}</span><span class="rule"></span><span>{fmtDate(post.data.date)}</span></div>
  </div>
</article>
