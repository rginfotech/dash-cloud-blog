---
import '../styles.css';
import { MAIN } from '../lib';
interface Props { title: string; description: string; type?: 'website' | 'article'; image?: string; jsonLd?: object[]; published?: Date; }
const { title, description, type = 'website', image, jsonLd = [], published } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(image ?? `${import.meta.env.BASE_URL}og-default.png`, Astro.site).href;
const base = import.meta.env.BASE_URL;
const fullTitle = title.includes('DashCloud') ? title : `${title} | DashCloud Blog`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}images/cloud_logo.svg`} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="DashCloud Blog" href={`${base}rss.xml`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="DashCloud Blog" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a href={`${MAIN}/`}><img src={`${base}images/cloud_logo.svg`} alt="Dash Cloud" /></a>
      <nav class="main" aria-label="Main">
        <a href={`${MAIN}/solutions/`}>Products</a>
        <a href={`${MAIN}/#ai-solutions`}>AI Solutions</a>
        <a href={base} aria-current="page">Blog</a>
        <a href={`${MAIN}/#team`}>About</a>
        <a href={`${MAIN}/#faq`}>FAQ</a>
        <a href={`${MAIN}/contact/`}>Contact</a>
        <a class="btn" href={`${MAIN}/contact/`}>Book a demo</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap">
      <div class="cols">
        <div class="about">
          <img src={`${base}images/cloud_logo.svg`} alt="Dash Cloud" />
          <p>Focused business software and AI solutions: white-label eCommerce, HR &amp; payroll, ticket booking, ERP and inventory, each product run on its own.</p>
          <a href="mailto:info@rginfotech.com">info@rginfotech.com</a>
          <a href="tel:+916376061123">+91 637 606 1123</a>
        </div>
        <div><h4>Products</h4><a href={`${MAIN}/dash-ecom/`}>Dash eCom</a><a href={`${MAIN}/dash-hr/`}>Dash HR</a><a href={`${MAIN}/solutions/dash-ems/`}>Dash EMS</a><a href={`${MAIN}/solutions/dash-erp/`}>Dash ERP</a><a href={`${MAIN}/solutions/dash-inventory/`}>Dash Inventory</a></div>
        <div><h4>AI Solutions</h4><a href={`${MAIN}/ai-solutions/ai-consulting-services/`}>AI Consulting &amp; Strategy</a><a href={`${MAIN}/ai-solutions/generative-ai-development/`}>Generative AI Development</a><a href={`${MAIN}/ai-solutions/ai-agent-development/`}>AI Agents Development</a><a href={`${MAIN}/ai-solutions/ai-automation-services/`}>AI Automation</a><a href={`${MAIN}/ai-solutions/conversational-ai-chatbot-development/`}>Conversational AI &amp; Chatbots</a></div>
        <div><h4>Company</h4><a href={`${MAIN}/#team`}>About</a><a href={`${MAIN}/contact/`}>Contact</a><a href={`${MAIN}/contact/`}>Book a demo</a><a href="https://www.rginfotech.com/" rel="noopener">RG Infotech</a></div>
        <div><h4>Resources</h4><a href={base}>Blog</a><a href={`${MAIN}/solutions/`}>All solutions</a><a href={`${MAIN}/#faq`}>FAQ</a><a href={`${base}rss.xml`}>RSS</a></div>
      </div>
      <div class="legal">© {new Date().getFullYear()} DashCloud. All rights reserved. A unit of <a href="https://www.rginfotech.com/" rel="noopener">RG Infotech Pvt. Ltd.</a></div>
    </div>
  </footer>
</body>
</html>
