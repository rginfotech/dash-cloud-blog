---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostImage from '../components/PostImage.astro';
import Cta from '../components/Cta.astro';
import PostCard from '../components/PostCard.astro';
import { VERTICALS } from '../categories';
import { getPosts, fmtDate, readingTime, slugify } from '../lib';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id && p.data.vertical === post.data.vertical).slice(0, 2) },
  }));
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const base = import.meta.env.BASE_URL;
const url = new URL(`${base}${post.id}/`, Astro.site).href;
const d = post.data;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description, datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(), author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: 'DashCloud', logo: { '@type': 'ImageObject', url: 'https://dashcloud.in/images/cloud_logo.svg' } }, mainEntityOfPage: url, keywords: (d.keywords.length ? d.keywords : d.tags).join(', '), articleSection: VERTICALS[d.vertical] },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL(base, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: VERTICALS[d.vertical], item: new URL(`${base}category/${d.vertical}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
];
---
<Base title={d.title} description={d.description} type="article" image={`${base}og/${post.id}.png`} published={d.date} keywords={d.keywords.length ? d.keywords : d.tags} jsonLd={jsonLd}>
  <div class="narrow">
    <article class="post">
      <div class="crumbs"><a href={base}>Blog</a> / <a href={`${base}category/${d.vertical}/`}>{VERTICALS[d.vertical]}</a></div>
      <h1>{d.title}</h1>
      <div class="meta"><span>{d.author}</span><span>{fmtDate(d.date)}</span><span>{readingTime(post.body)} min read</span></div>
      <div class="post-cover"><PostImage post={post} id={`p-${post.id}`} eager /></div>
      {toc.length > 2 && (
        <nav class="toc" aria-label="Contents"><strong>In this article</strong>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
      )}
      <div class="prose"><Content /></div>
      <div class="meta" style="margin-top:28px">{d.tags.map((t) => <a class="tag" href={`${base}tag/${slugify(t)}/`}>{t}</a>)}</div>
    </article>
    <Cta />
  </div>
  {related.length > 0 && (
    <div class="wrap related"><h2>Related reading</h2><div class="grid">{related.map((p) => <PostCard post={p} />)}</div></div>
  )}
</Base>
